{
  "name": "garnet-pdf",
  "version": "0.3.2",
  "private": true,
  "description": "Garnet PDF: a free PDF editor that works offline",
  "author": "Code2Box",
  "license": "AGPL-3.0-only",
  "main": "out/main/index.js",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write src tests scripts *.ts *.json",
    "test": "vitest run",
    "test:content": "npm test -w @garnet/pdf-content",
    "test:all": "npm test && npm run test:content",
    "e2e": "bash scripts/e2e.sh",
    "build": "electron-vite build",
    "dist:linux": "npm run build && electron-builder --linux dir AppImage",
    "dist:win": "bash scripts/dist-win.sh",
    "dist:mac": "bash scripts/dist-mac.sh",
    "dist:store": "node scripts/dist-store.mjs",
    "icons": "node scripts/icons.mjs",
    "notices": "node scripts/notices.mjs"
  },
  "dependencies": {
    "fontkit": "^2.0.4",
    "mupdf": "1.28.6",
    "pdfjs-dist": "^6.5.438",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@fontsource/inter": "^5.2.0",
    "@playwright/test": "^1.55.0",
    "@types/fontkit": "^2.0.8",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "bidi-js": "1.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^6.0.0",
    "eslint": "^9.0.0",
    "harfbuzzjs": "0.4.15",
    "lucide-react": "^0.468.0",
    "prettier": "^3.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.34.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "zustand": "^5.0.8"
  },
  "homepage": "https://garnetpdf.com"
}
